{
  "name": "@mafk/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/bin/server.js",
  "scripts": {
    "dev": "tsx watch src/bin/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:pure": "tsc --noEmit -p tsconfig.pure.json",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "bootstrap:master": "tsx src/bin/bootstrap-master.ts"
  },
  "dependencies": {
    "@mafk/database": "workspace:*",
    "@mafk/shared": "workspace:*",
    "@mafk/validation": "workspace:*",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.4",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "pdfkit": "0.17.2",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.20.4",
    "@types/pdfkit": "0.17.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
