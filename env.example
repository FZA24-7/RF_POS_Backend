# =====================================================================================================
# MAFK-24/7 Retail-Flow POS - configuration for LOCAL DEVELOPMENT.
#
# There is NO .env file in this project. The API, the seed script, the bootstrap script and the Prisma
# CLI read THIS file automatically (see packages/database/src/load-example-env.ts):
#   - real environment variables always win over the values below (use `set NAME=value` in cmd.exe);
#   - nothing is loaded when NODE_ENV=production;
#   - the API refuses the dev-only secrets below when NODE_ENV=production.
# Every value here is a LOCAL, dev-only placeholder - never reuse it anywhere reachable from a network.
# Full variable reference: docs/ENVIRONMENT.md
# =====================================================================================================

# [Required] Local PostgreSQL. Role "mafk" / database "mafk_pos" are created in docs/SETUP-WINDOWS-CMD.md.
DATABASE_URL=postgresql://mafk:mafk_local_dev@localhost:5432/mafk_pos

# [Required for tests] A DIFFERENT, isolated database whose name contains "test" (real-PostgreSQL tests).
TEST_DATABASE_URL=postgresql://mafk:mafk_local_dev@localhost:5432/mafk_pos_test

# [Required] Signs access tokens (>= 32 chars). Dev-only value; production must supply its own random secret.
JWT_SECRET=dev-only-local-secret-do-not-use-in-production-0123456789abcdef

# [Required] Allowed browser origin(s) for CORS, comma separated (the Vite dev server).
CLIENT_URL=http://localhost:5173

# --- Optional (defaults in docs/ENVIRONMENT.md). Uncomment to change; a blank value would be read as "". ---
# NODE_ENV=development
# PORT=4000
# API_URL=http://localhost:4000
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=14
# TRUST_PROXY=0
# LOGIN_MAX_FAILED_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15
# ARGON2_MEMORY_KIB=65536
# ARGON2_TIME_COST=3

# --- First Master Admin (used ONLY by `pnpm bootstrap:master`) ---
# There is deliberately NO default password. Supply it for that one command only, e.g. in cmd.exe:
#     set MASTER_ADMIN_PASSWORD=<your own strong password>
#     pnpm bootstrap:master
MASTER_ADMIN_LOGIN_ID=owner.admin
MASTER_ADMIN_NAME=Platform Owner
# MASTER_ADMIN_PASSWORD=
